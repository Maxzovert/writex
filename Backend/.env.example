# Backend — Auth0 + existing JWT
# Copy to Backend/.env and fill in values from the Auth0 dashboard.
# See docs/AUTH0_SETUP.md

PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
MONGO_URI=mongodb://127.0.0.1:27017/writex

# Auth0 (required for Google / Auth0 email login)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_spa_client_id
AUTH0_AUDIENCE=https://api.writex.local
