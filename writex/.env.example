# Frontend — copy to writex/.env
# See docs/AUTH0_SETUP.md for portal steps.

VITE_API_BASE_URL=http://localhost:5000

# Auth0 SPA (leave blank to keep legacy-only login UI)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
# Audience is optional for Google/email login (we sync with the ID token).
# Only set USE_AUDIENCE=true after you authorize this SPA under Auth0 → APIs → your API → Machine to Machine / Applications.
VITE_AUTH0_AUDIENCE=https://api.writex
VITE_AUTH0_USE_AUDIENCE=false
VITE_AUTH0_REDIRECT_URI=http://localhost:5173
# Optional — must match Auth0 Database connection name
VITE_AUTH0_DB_CONNECTION=Username-Password-Authentication

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
